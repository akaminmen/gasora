{
  "name": "gasora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gasora: la gasolina más barata, más cerca. PWA con los datos abiertos de precios de carburantes del Ministerio.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e && tsx scripts/e2e-data.ts --out dist/data",
    "build:e2e:base": "vite build --mode e2e --base / --outDir dist-base && tsx scripts/e2e-data.ts --out dist-base/data",
    "preview:base": "vite preview --base / --outDir dist-base --host 127.0.0.1 --port 4174 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:fixtures": "tsx scripts/ingest.ts --fixtures",
    "check:data": "tsx scripts/check-data.ts",
    "check:build": "tsx scripts/check-build.ts",
    "cadence": "tsx scripts/cadence.ts",
    "cadence:watch": "tsx scripts/cadence-watch.ts",
    "size": "tsx scripts/measure-size.ts",
    "icons": "tsx scripts/make-icons.ts",
    "hero-map": "tsx scripts/make-hero-map.ts",
    "brands:check": "tsx scripts/check-brands.ts",
    "compare:published": "tsx scripts/compare-published.ts",
    "verify:site": "tsx scripts/verify-site.ts",
    "licenses": "tsx scripts/licenses.ts",
    "screenshots": "tsx scripts/make-screenshots.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "lucide-react": "1.66.0",
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  }
}
